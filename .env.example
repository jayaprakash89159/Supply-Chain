DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_HSTS_SECONDS=0
DB_NAME=supplychain
DB_USER=supplychain
DB_PASSWORD=Vishwa@123
WEB_PORT=8000

# Outgoing email for quote requests (leave EMAIL_HOST empty to keep sending off).
# Google Workspace: smtp.gmail.com, port 587, an app password.  Microsoft 365: smtp.office365.com, port 587.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=purchase@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=VISHWA Purchase <purchase@example.com>
